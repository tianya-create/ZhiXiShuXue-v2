{
  "protocolVersion": "assist2009-gcn-dkt-v1",
  "schemaVersion": 1,
  "seeds": [42, 43, 44, 45, 46],
  "models": ["Full-DKT", "GCN-DKT", "RandomGraph-DKT", "Larger-DKT", "SelfLoop-DKT"],
  "graph": {
    "source": "train-attempt-multiskill-coannotation",
    "weight": "distinct-problem-support",
    "minSupport": 1,
    "normalization": "symmetric-with-unit-self-loop",
    "selfLoopWeight": 1,
    "randomization": "same-edge-count-and-weight-multiset",
    "randomRetryLimit": 100
  },
  "model": {
    "embedDim": 32,
    "hiddenSize": 64,
    "largerHiddenSize": 68,
    "graphLayers": 2,
    "graphHiddenDim": 32,
    "graphResidualScale": 1,
    "graphBranchDropout": 0,
    "dropout": 0.2,
    "residualFormula": "x_t = E[2*k_t + r_t] + Anorm·ReLU(Anorm·X·W1+b1)·W2+b2 [k_t]，X[k]=(E[2k]+E[2k+1])/2"
  },
  "training": {
    "learningRate": 0.001,
    "adamBetas": [0.9, 0.999],
    "adamEpsilon": 1e-8,
    "weightDecay": 0,
    "batchSize": 64,
    "maxEpochs": 50,
    "patience": 5,
    "minImprovement": 0.00001,
    "gradClipNorm": 5,
    "bceEps": 1e-7,
    "gradientReduction": "legacy-summed-target-gradients（锁定当前 dkt.js 实际梯度累计行为）"
  },
  "evaluation": {
    "bootstrapReps": 2000,
    "confidenceLevel": 0.95,
    "predictionDecimals": 6,
    "primaryMetric": "AUC",
    "comparisons": ["GCN-DKT − Full-DKT", "GCN-DKT − RandomGraph-DKT", "GCN-DKT − SelfLoop-DKT", "GCN-DKT − Larger-DKT"],
    "minimumMeanAucGainVsFull": 0.002,
    "maximumMeanLogLossIncreaseVsFull": 0.001,
    "selectionRule": "每项比较 AUC 点差 ≥4/5 种子为正且 ≥3/5 种子配对 CI 支持 GCN"
  },
  "data": {
    "rawFile": "backend/datasets/raw/skill_builder_data.csv",
    "rawSha256": "sha256:408698925fc3488672431e4c19b9b16808b6a25760f8e41ad4d3d6257ad0832a",
    "taskFile": "backend/datasets/assist2009/interactions.csv",
    "taskSha256": "sha256:6f055c6b5105b8295ef8bcf9dd23c668634f56eedc4dbdcf5a8708bee0618be9",
    "records": 266948,
    "students": 3931,
    "knowledgePoints": 100,
    "vocabRule": "完整任务固定词表（dkt.buildVocab(全任务序列)，与 dktEval 逐位一致），不随种子变化；train 未出现的 KP 保留为孤立节点；边仍仅来自 train 学生原始行",
    "split": "学生级 70/15/15（dkt.js splitStudents，每种子 train 2752 / val 590 / test 589）",
    "targetRule": "test 学生中非 (学生,KP) 组首时刻记录，与 DKT v2 完全一致"
  },
  "frozenBeforeTestRun": true,
  "frozenAt": "2026-10-31",
  "notes": [
    "本配置在正式 test 运行前冻结；之后不得按结果修改阈值或图规则。",
    "构图边界：仅 train 学生原始行；不用 response/correct；同题重复不重复加权。",
    "已知数据适配事实（如实披露）：真实共现图稀疏（42 边、64/100 孤立节点）；约 50% 的 test 目标位于具有非自环邻接边的节点上（逐种子数值见各 graph-real-manifest.nonIsolatedTargetCoverage，含分子/分母/目标清单哈希）。注意：孤立节点仍有逐节点编码器（自环+逐节点参数），不能断言其预测不受图分支影响。",
    "共现图表示关联，不等价于教学先修关系；即使通过也不得声称验证了先修关系价值。"
  ]
}
