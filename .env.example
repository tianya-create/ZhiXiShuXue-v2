# ===== 智析数学平台 生产环境配置 =====
# 复制本文件为 .env 后填写真实值（.env 不会被提交到 git）

# ---- 后端端口（容器内固定 5001，一般不用改）----
API_PORT=5001

# ---- 应用密钥（生产环境务必修改为随机字符串）----
# JWT_SECRET: 登录令牌签名密钥，泄露=任何人可伪造登录，务必改掉
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# 用于加密存储的 AI 密钥等敏感配置，不填会用不安全的默认值
SETTINGS_SECRET=please-change-me-to-a-random-string
APP_SECRET=please-change-me-to-a-random-string

# ---- 首次初始化管理员密码（必填）----
# 仅在数据库为空时使用；至少 12 位。生产环境只创建管理员账号，教师和学生请在管理端创建或导入。
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- 阿里云百炼（AI 小智 / 智能出题）----
# 获取地址：https://bailian.console.aliyun.com/  ->  API-KEY 管理
LLM_API_KEY=
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen-plus

OCR_API_KEY=
OCR_API_SECRET=

AI_TUTOR_PROVIDER=aliyun-bailian
AI_TUTOR_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_TUTOR_MODEL=qwen-plus
AI_TUTOR_API_KEY=

BAILIAN_PROVIDER=aliyun-bailian
BAILIAN_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_MODEL=qwen-plus
BAILIAN_API_KEY=
